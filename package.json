{
	"name": "ollamachat",
	"version": "1.3.7",
	"description": "Chatbot interface for locally hosted LLMs (like Ollama or LM Studio)",
	"license": "ISC",
	"author": "A Paul Anthony",
	"type": "module",
	"main": "index.html",
	"config": {
		"baseUrl": "http://localhost:1234/api/v1/",
		"model": "llama3",
		"engine": "LmStudioService",
		"temperature": 0.7,
		"store": false
	},
	"scripts": {
		"test": "vitest",
		"test:ui": "vitest --ui",
		"build": "vite build",
		"dev": "vite dev",
		"preview": "vite preview --host",
		"generate-icons": "node generate-icons.mjs"
	},
    "dependencies": {
        "dompurify": "^3.3.3",
        "jsqr": "^1.4.0",
        "katex": "^0.19.1",
        "marked": "^18.0.0",
        "qrcode": "^1.5.4",
        "mermaid": "^12.3.0"
    },	
	"devDependencies": {
		"jsdom": "^30.0.1",
		"sass": "^1.99.0",
		"sharp": "^0.35.5",
		"vite": "^8.0.4",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	}
}